generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Family {
  id           String   @id @default(cuid())
  name         String
  code         String   @unique
  currencyName String   @default("Credits")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users    User[]
  children Child[]
  devices  RegisteredDevice[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  pinHash      String?
  familyId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model Child {
  id           String        @id @default(cuid())
  name         String
  familyId     String?
  pinHash      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt
  family       Family?       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([familyId])
}

model RegisteredDevice {
  id         String       @id @default(cuid())
  familyId   String
  family     Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String       @unique
  status     DeviceStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt
  approvedAt DateTime?
  lastSeenAt DateTime?

  transactions Transaction[]

  @@index([familyId, status])
}

model Transaction {
  id           String            @id @default(cuid())
  childId      String
  child        Child             @relation(fields: [childId], references: [id], onDelete: Cascade)
  deviceId     String?
  device       RegisteredDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  source       TransactionSource @default(PARENT)
  amountCents  Int
  description  String
  transactedAt DateTime          @default(now())
  status       TransactionStatus @default(POSTED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  @@index([childId, transactedAt])
  @@index([deviceId])
}

model AppSettings {
  id           Int      @id @default(1)
  currencyName String   @default("Dollars")
  updatedAt    DateTime @updatedAt
}

enum DeviceStatus {
  PENDING
  APPROVED
  REVOKED
}

enum TransactionSource {
  PARENT
  KID_DEVICE
  PARENT_DEVICE
}

enum TransactionStatus {
  POSTED
  VOIDED
}
